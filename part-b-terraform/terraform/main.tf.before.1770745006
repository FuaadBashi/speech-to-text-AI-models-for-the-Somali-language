terraform {
  required_version = ">= 1.0"
  
  required_providers {
    hcs = {
      source  = "huaweicloud/hcs"
      version = "~> 2.4.0"
    }
  }
}

# HCS Provider with HTG Cloud custom endpoints
provider "hcs" {
  access_key = var.access_key
  secret_key = var.secret_key
  region     = var.region
  
  # Custom endpoints for HTG Cloud private cloud
  # Based on instructor's endpoint list
  endpoints {
    iam = "https://iam-apigateway-proxy.htgcloud-region-02.htgclouds.com/v3"
    ecs = "https://ecs-apigateway-proxy.htgcloud-region-02.htgclouds.com/v2"
    vpc = "https://vpc-apigateway-proxy.htgcloud-region-02.htgclouds.com/v1"
    evs = "https://evs-apigateway-proxy.htgcloud-region-02.htgclouds.com/v2"
    eip = "https://vpc-apigateway-proxy.htgcloud-region-02.htgclouds.com/v1"
    elb = "https://elb-apigateway-proxy.htgcloud-region-02.htgclouds.com/v2"
    rds = "https://rds-apigateway-proxy.htgcloud-region-02.htgclouds.com/v3"
    nat = "https://nat-apigateway-proxy.htgcloud-region-02.htgclouds.com/v2"
    ims = "https://ims-apigateway-proxy.htgcloud-region-02.htgclouds.com/v2"
    obs = "https://obs-apigateway-proxy.htgcloud-region-02.htgclouds.com"
    bms = "https://bms-apigateway-proxy.htgcloud-region-02.htgclouds.com/v1"
  }
}
