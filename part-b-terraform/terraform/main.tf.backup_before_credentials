terraform {
  required_providers {
    hcs = {
      source  = "huaweicloud/hcs"
      version = "~> 0.0.1"
    }
  }
}

provider "hcs" {
  region     = "Mogadishu-region-hq3h"
  access_key = var.access_key
  secret_key = var.secret_key
  
  endpoints = {
    iam = "https://service-hq3.htgclouds.com"
    ecs = "https://service-hq3.htgclouds.com"
    vpc = "https://service-hq3.htgclouds.com"
    evs = "https://service-hq3.htgclouds.com"
    eip = "https://service-hq3.htgclouds.com"
    nat = "https://service-hq3.htgclouds.com"
    elb = "https://service-hq3.htgclouds.com"
    rds = "https://service-hq3.htgclouds.com"
    as  = "https://service-hq3.htgclouds.com"
  }
}

variable "access_key" {
  description = "HTG Cloud Access Key"
  type        = string
  sensitive   = true
}

variable "secret_key" {
  description = "HTG Cloud Secret Key"
  type        = string
  sensitive   = true
}

# VPC Configuration
resource "hcs_vpc" "main" {
  name = "vpc-main"
  cidr = "10.0.0.0/16"
}

# Public Subnet
resource "hcs_vpc_subnet" "public" {
  name              = "subnet-public"
  cidr              = "10.0.1.0/24"
  gateway_ip        = "10.0.1.1"
  vpc_id            = hcs_vpc.main.id
  availability_zone = "hq3_AZ1"
}

# Private Subnet
resource "hcs_vpc_subnet" "private" {
  name              = "subnet-private"
  cidr              = "10.0.2.0/24"
  gateway_ip        = "10.0.2.1"
  vpc_id            = hcs_vpc.main.id
  availability_zone = "hq3_AZ1"
}

# Security Group - Web
resource "hcs_networking_secgroup" "web" {
  name        = "sg-web"
  description = "Security group for web servers"
}

# Security Group - App
resource "hcs_networking_secgroup" "app" {
  name        = "sg-app"
  description = "Security group for application servers"
}

# Security Group - Database
resource "hcs_networking_secgroup" "database" {
  name        = "sg-database"
  description = "Security group for database servers"
}

# Security Group - Bastion
resource "hcs_networking_secgroup" "bastion" {
  name        = "sg-bastion"
  description = "Security group for bastion/VPN server"
}

# Elastic IPs
resource "hcs_vpc_eip" "nat" {
  publicip {
    type = "5_bgp"
  }
  bandwidth {
    name        = "eip-nat"
    size        = 10
    share_type  = "PER"
    charge_mode = "traffic"
  }
}

resource "hcs_vpc_eip" "bastion" {
  publicip {
    type = "5_bgp"
  }
  bandwidth {
    name        = "eip-bastion"
    size        = 10
    share_type  = "PER"
    charge_mode = "traffic"
  }
}

resource "hcs_vpc_eip" "lb" {
  publicip {
    type = "5_bgp"
  }
  bandwidth {
    name        = "eip-lb"
    size        = 100
    share_type  = "PER"
    charge_mode = "traffic"
  }
}

# NAT Gateway
resource "hcs_nat_gateway" "main" {
  name                = "nat-main"
  spec                = "1"
  vpc_id              = hcs_vpc.main.id
  subnet_id           = hcs_vpc_subnet.public.id
}

# NAT SNAT Rule
resource "hcs_nat_snat_rule" "main" {
  nat_gateway_id = hcs_nat_gateway.main.id
  subnet_id      = hcs_vpc_subnet.private.id
  floating_ip_id = hcs_vpc_eip.nat.id
}

# RDS MySQL Instance
resource "hcs_rds_instance" "mysql" {
  name              = "rds-mysql-main"
  flavor            = "rds.mysql.s1.medium"
  vpc_id            = hcs_vpc.main.id
  subnet_id         = hcs_vpc_subnet.private.id
  security_group_id = hcs_networking_secgroup.database.id
  availability_zone = ["hq3_AZ1"]
  
  db {
    type     = "MySQL"
    version  = "8.0"
    port     = 3306
    password = var.db_password
  }
  
  volume {
    type = "COMMON"
    size = 100
  }
  
  backup_strategy {
    start_time = "02:00-03:00"
    keep_days  = 7
  }
}

variable "db_password" {
  description = "Database password"
  type        = string
  sensitive   = true
}

# Load Balancer
resource "hcs_elb_loadbalancer" "main" {
  name          = "elb-main"
  vpc_id        = hcs_vpc.main.id
  subnet_id     = hcs_vpc_subnet.public.id
}

# Associate EIP with Load Balancer
resource "hcs_vpc_eip_associate" "lb" {
  public_ip = hcs_vpc_eip.lb.address
  port_id   = hcs_elb_loadbalancer.main.vip_port_id
}

# Bastion/VPN Server
resource "hcs_compute_instance" "bastion" {
  name              = "ecs-bastion"
  flavor_id         = "s6.large.2"
  image_id          = "your-image-id"  # Replace with actual image ID
  availability_zone = "hq3_AZ1"
  
  network {
    uuid = hcs_vpc_subnet.public.id
  }
  
  security_group_ids = [hcs_networking_secgroup.bastion.id]
}

# Associate EIP with Bastion
resource "hcs_vpc_eip_associate" "bastion" {
  public_ip = hcs_vpc_eip.bastion.address
  port_id   = hcs_compute_instance.bastion.network[0].port
}

# Auto Scaling Configuration
resource "hcs_as_configuration" "web" {
  scaling_configuration_name = "as-config-web"
  instance_config {
    flavor    = "s6.large.2"
    image     = "your-image-id"  # Replace with actual image ID
    disk {
      size        = 40
      volume_type = "SATA"
      disk_type   = "SYS"
    }
    security_groups = [hcs_networking_secgroup.web.id]
  }
}

# Auto Scaling Group
resource "hcs_as_group" "web" {
  scaling_group_name       = "as-group-web"
  scaling_configuration_id = hcs_as_configuration.web.id
  desire_instance_number   = 2
  min_instance_number      = 1
  max_instance_number      = 5
  vpc_id                   = hcs_vpc.main.id
  
  networks {
    id = hcs_vpc_subnet.private.id
  }
  
  lbaas_listeners {
    listener_id = hcs_elb_listener.http.id
    pool_id     = hcs_elb_pool.http.id
  }
}

# ELB Listener
resource "hcs_elb_listener" "http" {
  name            = "listener-http"
  protocol        = "HTTP"
  protocol_port   = 80
  loadbalancer_id = hcs_elb_loadbalancer.main.id
  default_pool_id = hcs_elb_pool.http.id
}

# ELB Pool
resource "hcs_elb_pool" "http" {
  name        = "pool-http"
  protocol    = "HTTP"
  lb_method   = "ROUND_ROBIN"
  listener_id = hcs_elb_listener.http.id
}

# Security Group Rules
resource "hcs_networking_secgroup_rule" "web_http" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 80
  port_range_max    = 80
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = hcs_networking_secgroup.web.id
}

resource "hcs_networking_secgroup_rule" "web_https" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 443
  port_range_max    = 443
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = hcs_networking_secgroup.web.id
}

resource "hcs_networking_secgroup_rule" "bastion_ssh" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 22
  port_range_max    = 22
  remote_ip_prefix  = "0.0.0.0/0"
  security_group_id = hcs_networking_secgroup.bastion.id
}

resource "hcs_networking_secgroup_rule" "db_mysql" {
  direction         = "ingress"
  ethertype         = "IPv4"
  protocol          = "tcp"
  port_range_min    = 3306
  port_range_max    = 3306
  remote_group_id   = hcs_networking_secgroup.app.id
  security_group_id = hcs_networking_secgroup.database.id
}

# Outputs
output "vpc_id" {
  value = hcs_vpc.main.id
}

output "bastion_eip" {
  value = hcs_vpc_eip.bastion.address
}

output "lb_eip" {
  value = hcs_vpc_eip.lb.address
}

output "rds_endpoint" {
  value = hcs_rds_instance.mysql.private_ips[0]
}
