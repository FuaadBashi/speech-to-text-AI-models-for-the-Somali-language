# Copy this file to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to version control!

access_key      = "YOUR_HUAWEI_CLOUD_ACCESS_KEY"
secret_key      = "YOUR_HUAWEI_CLOUD_SECRET_KEY"
region          = "ap-southeast-1"
key_pair_name   = "my-ssh-key"
admin_cidr      = "YOUR_PUBLIC_IP/32"  # Replace with your actual public IP
db_password     = "YourSecurePassword123!"

# Optional overrides
# project_name    = "somali-asr-infra"
# environment     = "dev"
# instance_flavor = "s6.small.1"
