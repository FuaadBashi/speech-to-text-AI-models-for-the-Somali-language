# HTG Cloud Credentials

access_key  = "YOUR_ACCESS_KEY_HERE"
secret_key  = "YOUR_SECRET_KEY_HERE"
db_password = "YOUR_DB_PASSWORD_HERE"

# Optional: Image IDs from HTG Cloud console
# Leave empty to skip bastion and autoscaling resources
bastion_image_id = ""  # e.g., "abc123-image-id"
web_image_id     = ""  # e.g., "def456-image-id"
